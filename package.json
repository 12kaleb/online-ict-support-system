{
  "name": "local-ict-support-system",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n backend,frontend -c blue,green \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "lint": "npm run lint:backend && npm run lint:frontend",
    "lint:frontend": "npm --prefix frontend run lint",
    "lint:backend": "npm --prefix backend run lint",
    "build:frontend": "npm --prefix frontend run build",
    "start:frontend": "npm --prefix frontend run start",
    "seed:users": "npm --prefix backend run seed:users",
    "db:push": "npm --prefix backend exec prisma db push",
    "db:generate": "npm --prefix backend exec prisma generate"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
