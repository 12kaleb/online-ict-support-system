// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  manager
  technician
  staff
}

enum UserStatus {
  pending
  active
  disabled
}

model Profile {
  id            String         @id @default(uuid())
  name          String
  email         String         @unique
  passwordHash  String?
  role          UserRole       @default(staff)
  status        UserStatus     @default(active)
  canInviteStaff Boolean       @default(false)
  department    String?
  telegramChatId String?       @unique
  telegramLinkCode String?     @unique
  telegramLinkCodeExpiresAt DateTime?
  createdAt     DateTime       @default(now())
  tickets       Ticket[]       @relation("UserTickets")
  assigned      Ticket[]       @relation("AssignedTickets")
  comments      Comment[]
  notifications Notification[]
  history       TicketHistory[]
  assetUsages   AssetUsage[]
  assetRequests AssetRequest[]
  maintenances  Maintenance[]  @relation("MaintenanceTechnician")
  assetAssignments Asset[]     @relation("AssignedAssets")
  requestedApprovals ApprovalRequest[] @relation("ApprovalRequestedBy")
  reviewedApprovals ApprovalRequest[] @relation("ApprovalReviewedBy")
  assetHistoryEntries AssetHistory[]
  inviteTokens  InviteToken[]
}

model InviteToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model AllowedEmail {
  id        String   @id @default(uuid())
  email     String   @unique
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Ticket {
  id          String       @id @default(uuid())
  title       String
  description String
  status      String       @default("open") // open, in-progress, resolved, closed
  priority    String       @default("medium") // low, medium, high, critical
  category    String
  templateKey String?
  userId      String
  user        Profile      @relation("UserTickets", fields: [userId], references: [id], onDelete: Cascade)
  assignedTo  String?
  technician  Profile?     @relation("AssignedTickets", fields: [assignedTo], references: [id], onDelete: SetNull)
  assetId     String?
  asset       Asset?       @relation(fields: [assetId], references: [id], onDelete: SetNull)
  locationLatitude Float?
  locationLongitude Float?
  locationAccuracy Float?
  buildingBlockNo String?
  roomNumber  String?
  dueDate     DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  comments    Comment[]
  attachments Attachment[]
  feedback    Feedback?
  history     TicketHistory[]
  assetUsages AssetUsage[]
  isDelayed   Boolean      @default(false)
  delayReason String?
  slaStatus   String?      @default("on-track") // on-track, at-risk, breached
  slaPaused   Boolean      @default(false)
  slaPausedAt DateTime?
  slaPausedRemainingMinutes Int?
  blockingReason String?
  blockedAt   DateTime?
  isApproved  Boolean      @default(false)
  escalationLevel Int      @default(0)
  escalatedAt DateTime?
  resolvedAt  DateTime?
  closedAt    DateTime?
  approvalRequests ApprovalRequest[]
}

model AssetType {
  id        String   @id @default(uuid())
  name      String   @unique
  assets    Asset[]
  catalogs  AssetCatalog[]
  createdAt DateTime @default(now())
}

model AssetCatalog {
  id            String      @id @default(uuid())
  name          String
  brand         String?     // Dell, HP, Lenovo, etc.
  typeId        String?
  type          String
  assetType     AssetType?  @relation(fields: [typeId], references: [id])
  isConsumable  Boolean     @default(false)
  minStockLevel Int         @default(0)
  assets        Asset[]
  createdAt     DateTime    @default(now())
}

model Asset {
  id            String        @id @default(uuid())
  catalogId     String?
  catalog       AssetCatalog? @relation(fields: [catalogId], references: [id], onDelete: Cascade)
  name          String
  brand         String?       // Snapshot of catalog values for simpler reads
  typeId        String?
  type          String
  assetType     AssetType?    @relation(fields: [typeId], references: [id])
  serialNo      String?       @unique // Optional for consumables like RAM
  quantity      Int           @default(1)
  minStockLevel Int           @default(0)
  isConsumable  Boolean       @default(false)
  status        String        @default("active") // active, maintenance, retired, requested
  assignedUserId String?
  assignedUser  Profile?      @relation("AssignedAssets", fields: [assignedUserId], references: [id], onDelete: SetNull)
  assignedDepartment String?
  tickets       Ticket[]
  usages        AssetUsage[]
  maintenances  Maintenance[]
  requests      AssetRequest[]
  createdAt     DateTime      @default(now())
  history       AssetHistory[]
  maintenanceParts MaintenancePartUsage[]
  approvalRequests ApprovalRequest[]
}

model AssetRequest {
  id        String   @id @default(uuid())
  assetId   String
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  userId    String
  user      Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  status    String   @default("pending") // pending, fulfilled, returned
  userReturned Boolean @default(false)
  staffReturned Boolean @default(false)
  returnedAt DateTime?
  createdAt DateTime @default(now())
}

model AssetUsage {
  id        String   @id @default(uuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  assetId   String
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
  userId    String
  user      Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  status    String   @default("in-use") // in-use, returned
  userReturned Boolean @default(false)
  staffReturned Boolean @default(false)
  returnedAt DateTime?
  createdAt DateTime @default(now())
}

model Attachment {
  id        String   @id @default(uuid())
  name      String
  url       String   // Base64 or local path
  type      String   // image/png, application/pdf, etc.
  ticketId  String?
  ticket    Ticket?  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  commentId String?
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Comment {
  id          String       @id @default(uuid())
  message     String
  ticketId    String
  ticket      Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId      String
  user        Profile      @relation(fields: [userId], references: [id], onDelete: Cascade)
  isInternal  Boolean      @default(false)
  createdAt   DateTime     @default(now())
  attachments Attachment[]
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Feedback {
  id        String   @id @default(uuid())
  rating    Int      // 1-5
  comment   String?
  ticketId  String   @unique
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Maintenance {
  id          String   @id @default(uuid())
  title       String
  description String
  startTime   DateTime
  endTime     DateTime
  type        String   // Server, Network, Hardware, Preventive, Corrective, Upgrade
  status      String   @default("scheduled") // scheduled, in-progress, completed
  isDelayed   Boolean  @default(false)
  delayReason String?
  assetId     String?
  asset       Asset?   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  technicianId String?
  technician   Profile? @relation("MaintenanceTechnician", fields: [technicianId], references: [id], onDelete: SetNull)
  approvalRequests ApprovalRequest[]
  partsUsed   MaintenancePartUsage[]
  createdAt   DateTime @default(now())
}

model KnowledgeBase {
  id          String   @id @default(uuid())
  question    String   @unique
  answer      String
  category    String
  createdAt   DateTime @default(now())
}

model TicketHistory {
  id        String   @id @default(uuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId    String
  user      Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String   // e.g., "Status changed", "Assigned to", "Created"
  details   String?  // e.g., "From Open to In-Progress"
  createdAt DateTime @default(now())
}

model ApprovalRequest {
  id            String      @id @default(uuid())
  type          String      // asset-retirement, major-repair, high-priority-ticket-close
  status        String      @default("pending") // pending, approved, rejected
  reason        String?
  ticketId      String?
  ticket        Ticket?     @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  assetId       String?
  asset         Asset?      @relation(fields: [assetId], references: [id], onDelete: Cascade)
  maintenanceId String?
  maintenance   Maintenance? @relation(fields: [maintenanceId], references: [id], onDelete: Cascade)
  requestedById String
  requestedBy   Profile     @relation("ApprovalRequestedBy", fields: [requestedById], references: [id], onDelete: Cascade)
  reviewedById  String?
  reviewedBy    Profile?    @relation("ApprovalReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt    DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model AssetHistory {
  id            String      @id @default(uuid())
  assetId       String
  asset         Asset       @relation(fields: [assetId], references: [id], onDelete: Cascade)
  userId        String?
  user          Profile?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action        String
  details       String?
  ticketId      String?
  maintenanceId String?
  createdAt     DateTime    @default(now())
}

model MaintenancePartUsage {
  id            String      @id @default(uuid())
  maintenanceId String
  maintenance   Maintenance @relation(fields: [maintenanceId], references: [id], onDelete: Cascade)
  assetId       String
  asset         Asset       @relation(fields: [assetId], references: [id], onDelete: Cascade)
  quantity      Int         @default(1)
  notes         String?
  createdAt     DateTime    @default(now())
}
